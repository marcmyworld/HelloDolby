android_app_import {
    name: "HelloDolby",
    apk: "prebuilt/HelloDolby.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    system_ext_specific: true,
    required: [
        "privapp-permissions-hellodolby.xml",
    ],
}

prebuilt_etc {
    name: "privapp-permissions-hellodolby.xml",
    sub_dir: "permissions",
    src: "privapp-permissions-hellodolby.xml",
    system_ext_specific: true,
}
